# Copie para .env e ajuste. Credenciais apenas para ambiente local de experimento.
INFLUX_USER=admin
INFLUX_PASSWORD=change-me-please
INFLUX_ORG=unesp
INFLUX_BUCKET=iot
INFLUX_TOKEN=change-me-dev-token

GRAFANA_USER=admin
GRAFANA_PASSWORD=change-me-please

# Parâmetros da execução
IOTSIM_RUN_ID=dev
IOTSIM_DEVICES=10
IOTSIM_INTERVAL_S=1.0
IOTSIM_SEED=42
IOTSIM_MQTT_QOS=0
IOTSIM_COAP_CONFIRMABLE=false
IOTSIM_LOG_LEVEL=INFO
